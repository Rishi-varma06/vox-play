# Copy this file to .env and fill in your keys.
# python-dotenv will load it automatically when you run voxplay.

# Anthropic API key (required for live commentary; omit to use --mock mode)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API key (optional). Needed only for --tts elevenlabs, the
# broadcast-quality voice; it bills roughly one credit per character.
# The 'offline' and 'gtts' voices need no key at all.
# ELEVENLABS_API_KEY=...

# Optional overrides for that voice. Defaults are a British broadcast voice
# on the expressive model; which voice sounds right is a matter of taste and
# should not need a code change.
# ELEVENLABS_VOICE_ID=...
# ELEVENLABS_MODEL=...
