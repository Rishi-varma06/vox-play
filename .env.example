# Copy this file to .env and fill in your keys.
# python-dotenv will load it automatically when you run voxplay.

# Anthropic API key (required for live commentary; omit to use --mock mode)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API key (optional — only needed if you implement the ElevenLabs TTS provider)
# ELEVENLABS_API_KEY=...
